# Counters
TOTAL=0
SUCCESS=0
FAILED=0

# Failed files list
FAILED_FILES=()

# Test each file
for FILE in "${FILES[@]}"; do
  TOTAL=$((TOTAL + 1))

  # Check if file exists
  if [ ! -f "$FILE" ]; then
    echo "⚠  File not found: $FILE"
    FAILED=$((FAILED + 1))
    FAILED_FILES+=("$FILE (NOT FOUND)")
    continue
  fi

  # Get filename only
  BASENAME=$(basename "$FILE")
  ERROR_FILE="ariane_verible_errors/${BASENAME}.error"

  # Test with Verible parser (capture stderr)
  if dune exec ./test_verible_parse.exe "$FILE" > /dev/null 2> "$ERROR_FILE"; then
    echo "✓ $BASENAME"
    SUCCESS=$((SUCCESS + 1))
    rm -f "$ERROR_FILE"  # Remove error file if successful
  else
    echo "✗ $BASENAME (error captured)"
    FAILED=$((FAILED + 1))
    FAILED_FILES+=("$FILE")
  fi
done

# Print summary
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "  Summary"
echo "═══════════════════════════════════════════════════════════════"
echo "Total files:   $TOTAL"
echo "Successful:    $SUCCESS"
echo "Failed:        $FAILED"
echo ""

if [ $SUCCESS -gt 0 ]; then
  PERCENT=$((SUCCESS * 100 / TOTAL))
  echo "Success rate:  ${PERCENT}%"
fi

# Show failed files if any
if [ $FAILED -gt 0 ]; then
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  echo "  Failed Files (errors in ariane_verible_errors/)"
  echo "═══════════════════════════════════════════════════════════════"
  for FAIL in "${FAILED_FILES[@]}"; do
    BASENAME=$(basename "$FAIL")
    echo "  • $BASENAME"
  done
  echo ""
  echo "Error details saved in: ariane_verible_errors/"
fi

echo ""
echo "═══════════════════════════════════════════════════════════════"

# Exit with appropriate code
if [ $FAILED -eq 0 ]; then
  echo "✅ All files parsed successfully!"
  exit 0
else
  echo "⚠  Some files failed to parse (see ariane_verible_errors/ for details)"
  exit 1
fi
