; Minimal, dependency-light core for the topographical placer flow: the
; whole open eth-arp bitstream path (make svs_arp in v7-johnson-demo) needs
; ONLY place_lef.exe, and macOS opam environments often lack the heavy deps
; of the main stanza (lablgtk3, z3, hardcaml).  Keep this stanza buildable
; with nothing but str + yojson.
(library
 (name svs_place_core)
 (wrapped false)
 (modules behavioral_ir pack_to_lef)
 (libraries str yojson zarith))

(executables
 (names place_lef pack_to_lef_main)
 (modules place_lef pack_to_lef_main)
 (libraries svs_place_core str yojson zarith))

(ocamllex
 (modules Source_text_verible_lex Rtlil_input_lex surelog_uhdm_lex liberty_lex))

(menhir
 (modules Source_text_verible Rtlil_input surelog_uhdm liberty)
 (flags -la 2))

