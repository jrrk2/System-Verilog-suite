; In-suite FPGA technology mapper: BIR/hardcaml -> Xilinx-primitive
; netlist (LUTk/FDRE/CARRY4/RAMB/DSP48/IBUF/BUFG...) for nextpnr-xilinx.
; Isolated in its own library so [@@deriving hardcaml] can be enabled
; here (the main executables stanza only preprocesses ppx_deriving_yojson).
(library
 (name fpga_synth)
 (modules xil_prim lut_cover unisim_scan fpga_emit)
 (libraries hardcaml base)
 (preprocess (pps ppx_hardcaml)))

(executables
 (names test_fpga_prim test_lut_cover)
 (modules test_fpga_prim test_lut_cover)
 (libraries hardcaml base stdio fpga_synth)
 (preprocess (pps ppx_hardcaml)))
